# Notion API Configuration
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_token_here

# Notion Tasks Database ID
# The ID is in the URL when you open your database in Notion
# Example: https://www.notion.so/workspace/YOUR_DATABASE_ID?v=...
NOTION_DATABASE_ID=your_notion_database_id_here

# Notion Clients Database ID (for weekly email feature)
# This database should have: Name, Email properties
NOTION_CLIENTS_DATABASE_ID=your_clients_database_id_here

# Optional: Timesheet Database ID (if using a separate timesheet database)
# NOTION_TIMESHEET_DATABASE_ID=your_timesheet_database_id_here

# OpenAI API Key (for AI title generation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Client Passwords (JSON format)
# Format: {"client-name": "password", "another-client": "password2"}
# Example: {"about-time.com": "abc123", "acme-corp": "xyz789"}
CLIENT_PASSWORDS={}

# Resend API Key (for weekly email summaries)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email Configuration
EMAIL_FROM=dashboard@yourdomain.com
EMAIL_FROM_NAME=Project Dashboard

# Base URL (for email links)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Cron Secret (to secure cron endpoint)
# Generate a random string and set it in Vercel
CRON_SECRET=your_random_secret_here
