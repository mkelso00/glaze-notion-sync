# Notion API Configuration
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_token_here

# Notion Database ID
# The ID is in the URL when you open your database in Notion
# Example: https://www.notion.so/workspace/YOUR_DATABASE_ID?v=...
NOTION_DATABASE_ID=your_notion_database_id_here

# Optional: Timesheet Database ID (if using a separate timesheet database)
# NOTION_TIMESHEET_DATABASE_ID=your_timesheet_database_id_here

# OpenAI API Key (for AI title generation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
